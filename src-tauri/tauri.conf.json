{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Echo",
  "version": "0.2.2",
  "identifier": "com.theravanz.echo-tauri",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Echo",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; connect-src 'self' https://aoxzpqwiwuzypydexfrn.supabase.co https://api.microlink.io https://fonts.gstatic.com https://cdn.jsdelivr.net https://*.giphy.com; font-src 'self' data:; frame-src 'none'; object-src 'none'; media-src 'self' https:;",
      "assetProtocol": {
        "scope": [
          "$APPDATA/**",
          "$CACHE/**",
          "$RESOURCE/**",
          "$HOME/.cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["echomes"]
        }
      ],
      "desktop": {
        "schemes": ["echomes"]
      }
    }
  }
}
